{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.rubato103/nl-openapi-mcp",
  "description": "National Library of Korea Seoji OpenAPI search via REST API and local metadata harvesting",
  "version": "0.1.0",
  "repository": {
    "url": "https://github.com/rubato103/nl-openapi-mcp",
    "source": "github"
  },
  "websiteUrl": "https://github.com/rubato103/nl-openapi-mcp",
  "packages": [
    {
      "registryType": "mcpb",
      "identifier": "https://github.com/rubato103/nl-openapi-mcp/releases/download/v0.1.0/nl-openapi-mcp.mcpb",
      "version": "0.1.0",
      "transport": { "type": "stdio" },
      "fileSha256": "__MCPB_SHA256__",
      "environmentVariables": [
        {
          "name": "NL_API_KEY",
          "description": "National Library Seoji OpenAPI key (issued at librarian.nl.go.kr)",
          "isRequired": false,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}
